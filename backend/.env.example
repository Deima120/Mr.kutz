# MR. Kutz — Variables de entorno (backend)
# Copia este archivo a `.env` y completa los valores.

# Server
PORT=5000
NODE_ENV=development

# Database (Prisma / PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# JWT
JWT_SECRET=cambia_esta_clave_en_produccion
JWT_EXPIRES_IN=7d

# Frontend (CORS + enlaces en correos de reseña)
FRONTEND_URL=http://localhost:5173
PUBLIC_FRONTEND_URL=http://localhost:5173

# --- Correo (al menos un canal) ---
# Forzar proveedor: brevo | resend | smtp
# MAIL_PROVIDER=brevo

# Brevo API (recomendado en Render free; SMTP suele estar bloqueado)
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@tudominio.com

# Resend (alternativa HTTP)
RESEND_API_KEY=
RESEND_FROM=

# SMTP / nodemailer (útil en local; en producción requiere MAIL_ALLOW_SMTP_IN_PRODUCTION=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_TIMEOUT_MS=12000
# MAIL_ALLOW_SMTP_IN_PRODUCTION=false

# Cron de estados de cita (opcional)
CRON_SECRET=
# APPOINTMENT_STATUS_CRON_MS=60000
