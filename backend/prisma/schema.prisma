generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PurchaseStatus {
  draft
  ordered
  partially_received
  received
  cancelled
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum InventoryMovementType {
  purchase
  sale
  adjustment
  damage
  reversal
}

enum InventorySourceType {
  goods_receipt
  payment
  manual_adjustment
  reversal
}

enum PaymentLineType {
  service
  product
  manual
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  /// Los tres roles originales (admin, barber, client) son la base del flujo de
  /// negocio: no se pueden borrar ni renombrar desde el panel. Los roles que crea
  /// el administrador nacen con `false`.
  isSystem    Boolean  @default(false) @map("is_system")
  /// Un rol desactivado deja de poder asignarse a usuarios nuevos. No expulsa a
  /// quien ya lo tenía: para eso está `User.isActive`.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  users       User[]
  permissions RolePermission[]
}

/// Catálogo de permisos del sistema. Es una tabla de solo lectura para la
/// aplicación: se siembra desde `prisma/seed.js` a partir de
/// `src/config/permissions.js`, que es la fuente de verdad. Nadie crea permisos
/// desde el panel, porque un permiso sin código que lo consulte no haría nada.
model Permission {
  id          Int              @id @default(autoincrement())
  /// Código estable con forma `modulo.accion`, p. ej. `appointments.view.all`.
  code        String           @unique @db.VarChar(80)
  /// Módulo al que pertenece, para poder agruparlos en la pantalla de roles.
  module      String           @db.VarChar(40)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// Qué permisos tiene cada rol. `Cascade` en ambos lados: al borrar un rol
/// personalizado o al retirar un permiso del catálogo, sus asignaciones se van
/// con él y no queda basura.
model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                       Int                 @id @default(autoincrement())
  email                    String              @unique @db.VarChar(255)
  passwordHash             String              @map("password_hash") @db.VarChar(255)
  roleId                   Int                 @map("role_id")
  isActive                 Boolean             @default(true) @map("is_active")
  resetCode                String?             @map("reset_code") @db.VarChar(255)
  resetCodeExpires         DateTime?           @map("reset_code_expires")
  resetCodeAttempts        Int                 @default(0) @map("reset_code_attempts")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  barber                   Barber?
  client                   Client?
  inventoryMovements       InventoryMovement[] @relation("MovementsCreated")
  inventoryMovementsVoided InventoryMovement[] @relation("MovementsVoided")
  paymentsCreated          Payment[]           @relation("PaymentsCreated")
  paymentsVoided           Payment[]           @relation("PaymentsVoided")
  paymentLinesVoided       PaymentLine[]       @relation("PaymentLinesVoided")
  cashRegistersOpened      CashRegister[]      @relation("CashRegisterOpenedBy")
  cashRegistersClosed      CashRegister[]      @relation("CashRegisterClosedBy")
  expensesCreated          Expense[]           @relation("ExpensesCreated")
  expensesVoided           Expense[]           @relation("ExpensesVoided")
  otherIncomesCreated      OtherIncome[]       @relation("OtherIncomesCreated")
  otherIncomesVoided       OtherIncome[]       @relation("OtherIncomesVoided")
  purchasesCreated         Purchase[]          @relation("PurchasesCreated")
  purchasesCancelled       Purchase[]          @relation("PurchasesCancelled")
  suppliersCreated         Supplier[]          @relation("SuppliersCreated")
  goodsReceiptsCreated     GoodsReceipt[]      @relation("GoodsReceiptsCreated")
  role                     Role                @relation(fields: [roleId], references: [id])
}

model Client {
  id             Int           @id @default(autoincrement())
  userId         Int?          @unique @map("user_id")
  firstName      String        @map("first_name") @db.VarChar(100)
  lastName       String        @map("last_name") @db.VarChar(100)
  phone          String?       @db.VarChar(20)
  email          String?       @db.VarChar(255)
  documentType   String?       @map("document_type") @db.VarChar(40)
  documentNumber String?       @map("document_number") @db.VarChar(80)
  notes          String?       @db.VarChar(500)
  /// "Puede agendar". Distinto de `User.isActive` ("puede iniciar sesión"): los
  /// clientes creados desde la reserva pública no tienen `User`, así que sin este
  /// campo no habría forma de frenar a quien abusa del formulario sin cuenta.
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  appointments   Appointment[]
  payments       Payment[]
  user           User?         @relation(fields: [userId], references: [id])
}

model Barber {
  id             Int              @id @default(autoincrement())
  userId         Int              @unique @map("user_id")
  firstName      String           @map("first_name") @db.VarChar(100)
  lastName       String           @map("last_name") @db.VarChar(100)
  phone          String?          @db.VarChar(20)
  documentType   String?          @map("document_type") @db.VarChar(40)
  documentNumber String?          @map("document_number") @db.VarChar(80)
  specialties    String[]         @default([])
  isActive       Boolean          @default(true) @map("is_active")
  commissionPercent Decimal?      @map("commission_percent") @db.Decimal(5, 2)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  appointments   Appointment[]
  commissionEntries CommissionEntry[]
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules      BarberSchedule[]
}

model BarberSchedule {
  id          Int      @id @default(autoincrement())
  barberId    Int      @map("barber_id")
  dayOfWeek   Int      @map("day_of_week")
  startTime   DateTime @map("start_time") @db.Time(6)
  endTime     DateTime @map("end_time") @db.Time(6)
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  barber      Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@map("barber_schedules")
}

/// Excepciones del calendario de la barbería: cierres puntuales y horarios
/// especiales. Los festivos colombianos NO se guardan aquí — se calculan en
/// `utils/colombianHolidays.js` para no depender de que alguien los cargue cada
/// año. Esta tabla es solo para lo que ningún calendario sabe: un cierre por
/// inventario, un puente que se decide trabajar, el 24 de diciembre con horario
/// corto. Una excepción manda siempre sobre el festivo calculado.
model ScheduleException {
  id        Int       @id @default(autoincrement())
  /// Día afectado. Único: una sola excepción por fecha.
  date      DateTime  @unique @db.Date
  /// `true` cierra la barbería ese día e ignora las horas.
  isClosed  Boolean   @default(false) @map("is_closed")
  /// Horario especial. Si van vacías y no está cerrado, el día se trata como
  /// normal (sirve para anular un festivo y trabajar igual).
  startTime DateTime? @map("start_time") @db.Time(6)
  endTime   DateTime? @map("end_time") @db.Time(6)
  reason    String?   @db.VarChar(200)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("schedule_exceptions")
}

model Service {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(150)
  categoryId      Int?             @map("category_id")
  category        ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description     String?
  price           Decimal          @db.Decimal(10, 2)
  durationMinutes Int              @map("duration_minutes")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  appointments    Appointment[]
}

model ServiceCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  services    Service[]

  @@map("service_categories")
}

model Appointment {
  id                  Int       @id @default(autoincrement())
  clientId            Int       @map("client_id")
  barberId            Int       @map("barber_id")
  serviceId           Int       @map("service_id")
  appointmentDate     DateTime  @map("appointment_date") @db.Date
  startTime           DateTime  @map("start_time") @db.Time(6)
  endTime             DateTime  @map("end_time") @db.Time(6)
  status              String    @default("scheduled") @db.VarChar(20)
  notes               String?
  /// Motivo obligatorio al cancelar (cliente o admin)
  cancelReason        String?   @map("cancel_reason") @db.VarChar(500)
  /// Valoración del cliente tras cita completada (1–5); una vez por cita
  clientRating        Int?      @map("client_rating")
  clientRatingComment String?   @map("client_rating_comment") @db.VarChar(2000)
  clientRatedAt       DateTime? @map("client_rated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  barber              Barber    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  client              Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service             Service   @relation(fields: [serviceId], references: [id])
  paymentLines        PaymentLine[]
  commissionEntries   CommissionEntry[]

  /// El conteo de citas pendientes por cliente corre en cada intento de reserva.
  @@index([clientId, appointmentDate])
  /// Misma forma de consulta que ya hacen el chequeo de solapes y el cálculo de
  /// horarios disponibles en cada pantalla de reserva.
  @@index([barberId, appointmentDate])
}

model PaymentMethod {
  id          Int                 @id @default(autoincrement())
  name        String              @unique @db.VarChar(50)
  description String?             @db.VarChar(255)
  isActive    Boolean             @default(true) @map("is_active")
  isCash      Boolean             @default(false) @map("is_cash")
  payments    Payment[]
  methodSplits PaymentMethodSplit[]
  otherIncomes OtherIncome[]

  @@map("payment_methods")
}

model Payment {
  id                 Int                  @id @default(autoincrement())
  clientId           Int?                 @map("client_id")
  amount             Decimal              @db.Decimal(10, 2)
  paymentMethodId    Int?                 @map("payment_method_id")
  cashRegisterId     Int?                 @map("cash_register_id")
  reference          String               @unique @db.VarChar(100)
  notes              String?
  amountTendered     Decimal?             @map("amount_tendered") @db.Decimal(10, 2)
  changeGiven        Decimal?             @map("change_given") @db.Decimal(10, 2)
  createdBy          Int?                 @map("created_by")
  createdAt          DateTime             @default(now()) @map("created_at")
  voidedAt           DateTime?            @map("voided_at")
  voidReason         String?              @map("void_reason") @db.VarChar(500)
  voidedBy           Int?                 @map("voided_by")
  client             Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  creator            User?                @relation("PaymentsCreated", fields: [createdBy], references: [id])
  voider             User?                @relation("PaymentsVoided", fields: [voidedBy], references: [id], onDelete: SetNull)
  paymentMethod      PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  cashRegister       CashRegister?        @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  lines              PaymentLine[]
  methodSplits       PaymentMethodSplit[]
  inventoryMovements InventoryMovement[]
  commissionEntries  CommissionEntry[]

  @@index([clientId])
  @@index([createdAt])
  @@index([voidedAt])
  @@index([cashRegisterId])
}

/// Sesión de caja diaria (apertura/cierre). Los cobros se asocian a la caja OPEN.
model CashRegister {
  id            Int                @id @default(autoincrement())
  businessDate  DateTime           @map("business_date") @db.Date
  openingAmount Decimal            @map("opening_amount") @db.Decimal(10, 2)
  openedById    Int                @map("opened_by")
  openedAt      DateTime           @default(now()) @map("opened_at")
  status        CashRegisterStatus @default(OPEN)
  closedById    Int?               @map("closed_by")
  closedAt      DateTime?          @map("closed_at")
  countedCash   Decimal?           @map("counted_cash") @db.Decimal(10, 2)
  notes         String?
  openedBy      User               @relation("CashRegisterOpenedBy", fields: [openedById], references: [id])
  closedBy      User?              @relation("CashRegisterClosedBy", fields: [closedById], references: [id])
  payments      Payment[]
  otherIncomes  OtherIncome[]

  @@unique([businessDate])
  @@index([status])
  @@map("cash_registers")
}

/// Categorías de gasto operativo (lista fija editable).
model ExpenseCategory {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  expenses  Expense[]

  @@map("expense_categories")
}

/// Gasto operativo manual (no incluye compras de inventario).
model Expense {
  id             Int             @id @default(autoincrement())
  categoryId     Int             @map("category_id")
  amount         Decimal         @db.Decimal(10, 2)
  expenseDate    DateTime        @map("expense_date") @db.Date
  notes          String?         @db.VarChar(500)
  attachmentUrl  String?         @map("attachment_url") @db.VarChar(500)
  reference      String?         @db.VarChar(40)
  createdById    Int             @map("created_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  voidedAt       DateTime?       @map("voided_at")
  voidReason     String?         @map("void_reason") @db.VarChar(500)
  voidedById     Int?            @map("voided_by")
  category       ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("ExpensesCreated", fields: [createdById], references: [id])
  voidedBy       User?           @relation("ExpensesVoided", fields: [voidedById], references: [id])

  @@index([expenseDate])
  @@index([categoryId])
  @@index([voidedAt])
  @@map("expenses")
}

/// Ingreso fuera de ventas (alquiler silla, etc.). Siempre ligado a caja OPEN.
model OtherIncome {
  id              Int           @id @default(autoincrement())
  amount          Decimal       @db.Decimal(10, 2)
  incomeDate      DateTime      @map("income_date") @db.Date
  description     String        @db.VarChar(200)
  paymentMethodId Int           @map("payment_method_id")
  cashRegisterId  Int           @map("cash_register_id")
  reference       String?       @db.VarChar(40)
  notes           String?       @db.VarChar(500)
  createdById     Int           @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  voidedAt        DateTime?     @map("voided_at")
  voidReason      String?       @map("void_reason") @db.VarChar(500)
  voidedById      Int?          @map("voided_by")
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  cashRegister    CashRegister  @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  createdBy       User          @relation("OtherIncomesCreated", fields: [createdById], references: [id])
  voidedBy        User?         @relation("OtherIncomesVoided", fields: [voidedById], references: [id])

  @@index([incomeDate])
  @@index([cashRegisterId])
  @@index([voidedAt])
  @@map("other_incomes")
}

/// Snapshot de comisión al cobrar un servicio (línea service).
model CommissionEntry {
  id                 Int         @id @default(autoincrement())
  paymentId          Int         @map("payment_id")
  paymentLineId      Int         @unique @map("payment_line_id")
  appointmentId      Int         @map("appointment_id")
  barberId           Int         @map("barber_id")
  serviceAmount      Decimal     @map("service_amount") @db.Decimal(10, 2)
  commissionPercent  Decimal     @map("commission_percent") @db.Decimal(5, 2)
  commissionAmount   Decimal     @map("commission_amount") @db.Decimal(10, 2)
  createdAt          DateTime    @default(now()) @map("created_at")
  voidedAt           DateTime?   @map("voided_at")
  payment            Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentLine        PaymentLine @relation(fields: [paymentLineId], references: [id], onDelete: Restrict)
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  barber             Barber      @relation(fields: [barberId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([barberId])
  @@index([paymentId])
  @@index([voidedAt])
  @@map("commission_entries")
}

/// Cómo se pagó el cobro (uno o varios métodos). Independiente de PaymentLine (qué se cobró).
model PaymentMethodSplit {
  id              Int           @id @default(autoincrement())
  paymentId       Int           @map("payment_id")
  paymentMethodId Int           @map("payment_method_id")
  amount          Decimal       @db.Decimal(10, 2)
  createdAt       DateTime      @default(now()) @map("created_at")
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@unique([paymentId, paymentMethodId])
  @@index([paymentMethodId])
  @@map("payment_method_splits")
}

model PaymentLine {
  id                 Int                   @id @default(autoincrement())
  paymentId          Int                   @map("payment_id")
  lineType           PaymentLineType       @map("line_type")
  appointmentId      Int?                  @map("appointment_id")
  productId          Int?                  @map("product_id")
  quantity           Int                   @default(1)
  unitPrice          Decimal               @map("unit_price") @db.Decimal(10, 2)
  lineAmount         Decimal               @map("line_amount") @db.Decimal(10, 2)
  description        String?               @db.VarChar(200)
  voidedAt           DateTime?             @map("voided_at")
  voidReason         String?               @map("void_reason") @db.VarChar(500)
  voidedBy           Int?                  @map("voided_by")
  createdAt          DateTime              @default(now()) @map("created_at")
  payment            Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  appointment        Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  product            Product?              @relation(fields: [productId], references: [id], onDelete: Restrict)
  voider             User?                 @relation("PaymentLinesVoided", fields: [voidedBy], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]
  commissionEntry    CommissionEntry?

  @@index([paymentId])
  @@index([productId])
  @@index([appointmentId])
  @@map("payment_lines")
}

model Product {
  id                 Int                 @id @default(autoincrement())
  categoryId         Int?                @map("category_id")
  name               String              @db.VarChar(150)
  description        String?
  sku                String?             @unique @db.VarChar(50)
  retailPrice        Decimal?            @map("retail_price") @db.Decimal(10, 2)
  costPrice          Decimal?            @map("cost_price") @db.Decimal(10, 2)
  unit               String              @default("unit") @db.VarChar(20)
  minStock           Int                 @default(0) @map("min_stock")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  category           ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventory          Inventory?
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]
  paymentLines       PaymentLine[]
}

model Inventory {
  id          Int      @id @default(autoincrement())
  productId   Int      @unique @map("product_id")
  quantity    Int      @default(0)
  lastUpdated DateTime @default(now()) @map("last_updated")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id                   Int                    @id @default(autoincrement())
  productId            Int                    @map("product_id")
  quantityChange       Int                    @map("quantity_change")
  movementType         InventoryMovementType? @map("movement_type")
  sourceType           InventorySourceType?   @map("source_type")
  goodsReceiptItemId   Int?                   @unique @map("goods_receipt_item_id")
  paymentId            Int?                   @map("payment_id")
  paymentLineId        Int?                   @map("payment_line_id")
  reversalOfMovementId Int?                   @unique @map("reversal_of_movement_id")
  notes                String?
  createdBy            Int?                   @map("created_by")
  createdAt            DateTime               @default(now()) @map("created_at")
  voidedAt             DateTime?              @map("voided_at")
  voidReason           String?                @map("void_reason")
  voidedBy             Int?                   @map("voided_by")
  creator              User?                  @relation("MovementsCreated", fields: [createdBy], references: [id], onDelete: SetNull)
  voider               User?                  @relation("MovementsVoided", fields: [voidedBy], references: [id], onDelete: SetNull)
  product              Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  goodsReceiptItem     GoodsReceiptItem?      @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  payment              Payment?               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentLine          PaymentLine?           @relation(fields: [paymentLineId], references: [id], onDelete: Restrict)
  reversalOfMovement   InventoryMovement?     @relation("MovementReversal", fields: [reversalOfMovementId], references: [id], onDelete: Restrict)
  reversalMovement     InventoryMovement?     @relation("MovementReversal")

  @@index([productId, createdAt])
  @@index([paymentId])
  @@index([paymentLineId])
  @@map("InventoryMovement")
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("product_categories")
}

model Supplier {
  id             Int        @id @default(autoincrement())
  name           String     @db.VarChar(150)
  normalizedName String     @unique @map("normalized_name") @db.VarChar(150)
  taxId          String?    @unique @map("tax_id") @db.VarChar(50)
  contactName    String?    @map("contact_name") @db.VarChar(150)
  email          String?    @db.VarChar(255)
  phone          String?    @db.VarChar(30)
  address        String?    @db.VarChar(500)
  notes          String?    @db.VarChar(1000)
  isActive       Boolean    @default(true) @map("is_active")
  createdBy      Int?       @map("created_by")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  creator        User?      @relation("SuppliersCreated", fields: [createdBy], references: [id], onDelete: SetNull)
  purchases      Purchase[]

  @@index([isActive, name])
  @@map("suppliers")
}

model Purchase {
  id            Int            @id @default(autoincrement())
  supplierId    Int            @map("supplier_id")
  supplierName  String?        @map("supplier_name") @db.VarChar(150)
  orderNumber   String         @unique @map("order_number") @db.VarChar(80)
  invoiceNumber String?        @map("invoice_number") @db.VarChar(80)
  status        PurchaseStatus @default(draft)
  orderedAt     DateTime?      @map("ordered_at")
  expectedAt    DateTime?      @map("expected_at")
  notes         String?
  totalAmount   Decimal        @default(0) @map("total_amount") @db.Decimal(10, 2)
  createdBy     Int?           @map("created_by")
  voidedAt      DateTime?      @map("voided_at")
  voidReason    String?        @map("void_reason") @db.VarChar(500)
  voidedBy      Int?           @map("voided_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  creator       User?          @relation("PurchasesCreated", fields: [createdBy], references: [id], onDelete: SetNull)
  cancelledBy   User?          @relation("PurchasesCancelled", fields: [voidedBy], references: [id], onDelete: SetNull)
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items         PurchaseItem[]
  receipts      GoodsReceipt[]

  // Una misma factura no puede repetirse con el mismo proveedor. Postgres trata los
  // NULL como distintos, asi que varias ordenes sin factura siguen siendo validas.
  @@unique([supplierId, invoiceNumber])
  @@index([supplierId, status])
  @@index([status, createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id               Int                @id @default(autoincrement())
  purchaseId       Int                @map("purchase_id")
  productId        Int                @map("product_id")
  quantity         Int
  receivedQuantity Int                @default(0) @map("received_quantity")
  unitCost         Decimal            @map("unit_cost") @db.Decimal(10, 2)
  subtotal         Decimal            @default(0) @db.Decimal(10, 2)
  createdAt        DateTime           @default(now()) @map("created_at")
  product          Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchase         Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  receiptItems     GoodsReceiptItem[]

  @@index([purchaseId, productId])
  @@map("purchase_items")
}

model GoodsReceipt {
  id            Int                @id @default(autoincrement())
  purchaseId    Int                @map("purchase_id")
  receiptNumber String             @unique @map("receipt_number") @db.VarChar(80)
  receivedAt    DateTime           @default(now()) @map("received_at")
  notes         String?            @db.VarChar(1000)
  createdBy     Int?               @map("created_by")
  createdAt     DateTime           @default(now()) @map("created_at")
  purchase      Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  creator       User?              @relation("GoodsReceiptsCreated", fields: [createdBy], references: [id], onDelete: SetNull)
  items         GoodsReceiptItem[]

  @@index([purchaseId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             Int                @id @default(autoincrement())
  goodsReceiptId Int                @map("goods_receipt_id")
  purchaseItemId Int                @map("purchase_item_id")
  quantity       Int
  unitCost       Decimal            @map("unit_cost") @db.Decimal(10, 2)
  createdAt      DateTime           @default(now()) @map("created_at")
  goodsReceipt   GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseItem   PurchaseItem       @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  movement       InventoryMovement?

  @@unique([goodsReceiptId, purchaseItemId])
  @@index([purchaseItemId])
  @@map("goods_receipt_items")
}

model BusinessSetting {
  id             Int      @id @default(autoincrement())
  businessName   String   @default("Mr. Kutz") @map("business_name") @db.VarChar(150)
  logoUrl        String?  @map("logo_url") @db.VarChar(500)
  primaryColor   String?  @map("primary_color") @db.VarChar(20)
  secondaryColor String?  @map("secondary_color") @db.VarChar(20)
  contactEmail   String?  @map("contact_email") @db.VarChar(255)
  contactPhone   String?  @map("contact_phone") @db.VarChar(50)
  address        String?
  openingHours               String?  @map("opening_hours")
  defaultCommissionPercent   Decimal  @default(40) @map("default_commission_percent") @db.Decimal(5, 2)
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("business_settings")
}

/// Contadores diarios de folios internos (MKP / PO / GR). Preparado para rangos DIAN futuros.
model DocumentSequence {
  id        Int      @id @default(autoincrement())
  docType   String   @map("doc_type") @db.VarChar(32)
  periodKey String   @map("period_key") @db.VarChar(8)
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([docType, periodKey])
  @@map("document_sequences")
}

/// Textos curados para la landing pública; no sustituyen la valoración operativa en Appointment.
model Testimonial {
  id         Int      @id @default(autoincrement())
  authorName String   @map("author_name") @db.VarChar(100)
  authorRole String?  @map("author_role") @db.VarChar(50)
  content    String   @db.VarChar(1000)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}
