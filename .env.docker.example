# =============================================================================
# Variables para levantar Mr.Kutz con Docker Compose
# =============================================================================
# Copia este archivo como `.env` en la raíz del repositorio:
#
#   cp .env.docker.example .env
#
# Compose lee automáticamente el `.env` de la raíz. Ese archivo está en
# .gitignore, así que nunca se sube al repositorio.
#
# IMPORTANTE: este `.env` de la raíz es SOLO para Docker. No sustituye ni
# interfiere con `backend/.env`, que se sigue usando al ejecutar el proyecto
# sin contenedores (`npm run dev`). Son dos archivos independientes.
# -----------------------------------------------------------------------------

# ---- Base de datos PostgreSQL (contenedor local) ----------------------------
# Estas credenciales son de la base que crea Docker en tu equipo, no de la base
# de producción. Aun así, cámbialas: una contraseña de ejemplo no debería
# quedarse puesta.
POSTGRES_USER=mrkutz
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=mrkutz

# ---- Seguridad ---------------------------------------------------------------
# OBLIGATORIO. Firma los tokens de sesión: si cambia, todas las sesiones
# abiertas dejan de ser válidas. Genera uno propio, largo y aleatorio, por
# ejemplo con:  openssl rand -base64 48
JWT_SECRET=genera_un_secreto_largo_y_aleatorio_para_este_entorno
JWT_EXPIRES_IN=7d

# ---- Puertos en tu equipo ----------------------------------------------------
# Cámbialos solo si alguno ya está ocupado.
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=5000
DB_HOST_PORT=5433

# ---- Entorno -----------------------------------------------------------------
# `production` ejecuta el sistema igual que en el despliegue real (es lo que
# conviene mostrar en una sustentación). Si lo pones en `development`, el
# backend acepta además los orígenes locales sin declararlos.
NODE_ENV=production

# Origen exacto desde el que se abre la aplicación en el navegador. Debe
# coincidir con FRONTEND_HOST_PORT o el backend rechazará las peticiones por
# CORS cuando NODE_ENV=production.
FRONTEND_URL=http://localhost:8080

# ---- Opcionales --------------------------------------------------------------
# Ruta de la API incrustada en el bundle del frontend. Déjala en /api salvo que
# sirvas el backend en otro dominio.
VITE_API_URL=/api

# Cada cuántos milisegundos revisa el sistema los estados de las citas
# (confirmada → en progreso → completada). 0 lo desactiva.
APPOINTMENT_STATUS_CRON_MS=60000

# Correo transaccional. Sin esto el sistema funciona, pero no envía correos.
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=
# BREVO_FROM_EMAIL=
# RESEND_API_KEY=
# RESEND_FROM=
